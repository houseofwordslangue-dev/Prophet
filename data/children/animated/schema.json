{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "children-animated-story-v1",
  "title": "Animated Children Story",
  "type": "object",
  "required": ["id","slug","titleAr","titleEn","titleFr","ageGroup","readingLevel","category","categoryAr","secondaryTags","visualStyle","fictional","historicalClaim","synopsisAr","synopsisEn","synopsisFr","moralAr","moralEn","moralFr","characters","storyAr","storyEn","storyFr","scenes","cover","estimatedReadingMinutes","estimatedAnimationMinutes","listenMode","watchMode","capabilities","lifecycleStatus","publicationStatus"],
  "properties": {
    "id": {"type":"string","pattern":"^animated-story-[0-9]{3}$"},
    "slug": {"type":"string","minLength":3},
    "titleAr": {"type":"string","minLength":3},
    "titleEn": {"type":"string","minLength":3},
    "titleFr": {"type":"string","minLength":3},
    "ageGroup": {"enum":["5-7","8-10","11-13","14-16"]},
    "readingLevel": {"enum":["beginner","developing","intermediate","advanced"]},
    "category": {"enum":["kindness","honesty","courage","patience","curiosity","cooperation","responsibility","gratitude","nature","forgiveness"]},
    "categoryAr": {"type":"string"},
    "secondaryTags": {"type":"array","minItems":1,"items":{"type":"string"}},
    "visualStyle": {"type":"string","minLength":3},
    "fictional": {"const":true},
    "historicalClaim": {"const":false},
    "synopsisAr": {"type":"string","minLength":20},
    "synopsisEn": {"type":"string","minLength":20},
    "synopsisFr": {"type":"string","minLength":20},
    "moralAr": {"type":"string","minLength":10},
    "moralEn": {"type":"string","minLength":10},
    "moralFr": {"type":"string","minLength":10},
    "characters": {"type":"array","minItems":2,"items":{"type":"object","required":["characterId","name","age","role","personality","strengths","weakness","appearanceDescription","clothingDescription","consistencyPrompt"]}},
    "storyAr": {"$ref":"#/$defs/storyBlocks"},
    "storyEn": {"$ref":"#/$defs/storyBlocks"},
    "storyFr": {"$ref":"#/$defs/storyBlocks"},
    "scenes": {"type":"array","minItems":8,"maxItems":12,"items":{"$ref":"#/$defs/scene"}},
    "cover": {"type":"object","required":["path","altAr","altEn","altFr","format"]},
    "estimatedReadingMinutes": {"type":"number","minimum":1},
    "estimatedAnimationMinutes": {"type":"number","minimum":1},
    "listenMode": {"enum":["native-audio","browser-tts"]},
    "watchMode": {"enum":["animated-storyboard","native-video"]},
    "capabilities": {"type":"object","required":["read","listen","watch"],"properties":{"read":{"type":"boolean"},"listen":{"type":"boolean"},"watch":{"type":"boolean"}}},
    "lifecycleStatus": {"enum":["DRAFT","SCRIPT_READY","ART_PENDING","ART_READY","AUDIO_PENDING","AUDIO_READY","ANIMATION_READY","REVISION","READY","PUBLISHED","FAILED"]},
    "publicationStatus": {"enum":["READY","PUBLISHED","FAILED","DRAFT"]}
  },
  "$defs": {
    "storyBlocks": {"type":"array","minItems":8,"maxItems":12,"items":{"type":"object","required":["sceneNumber","text"],"properties":{"sceneNumber":{"type":"integer","minimum":1},"text":{"type":"string","minLength":40}}}},
    "scene": {"type":"object","required":["sceneNumber","sceneTitle","setting","visualDescription","narration","dialogue","charactersPresent","emotionalTone","durationSeconds","animationInstructions","illustrationPrompt","illustration"],"properties":{"sceneNumber":{"type":"integer","minimum":1},"sceneTitle":{"type":"string"},"setting":{"type":"string"},"visualDescription":{"type":"string"},"narration":{"type":"string"},"dialogue":{"type":"array","minItems":1},"charactersPresent":{"type":"array","minItems":1},"emotionalTone":{"type":"string"},"durationSeconds":{"type":"number","minimum":1},"animationInstructions":{"type":"string"},"illustrationPrompt":{"type":"string"},"illustration":{"type":"string"}}}
  }
}
