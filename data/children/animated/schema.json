{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "children-animated-story-v2",
  "title": "Fully Localized Animated Children Story",
  "type": "object",
  "required": [
    "id","slug","titleAr","titleEn","titleFr","ageGroup","readingLevel","readingLevelAr","readingLevelEn","readingLevelFr",
    "category","categoryAr","categoryEn","categoryFr","secondaryTags","secondaryTagsAr","secondaryTagsEn","secondaryTagsFr",
    "visualStyle","fictional","historicalClaim","synopsisAr","synopsisEn","synopsisFr","moralAr","moralEn","moralFr",
    "characters","storyAr","storyEn","storyFr","scenes","cover","estimatedReadingMinutes","estimatedAnimationMinutes",
    "listenMode","watchMode","capabilities","lifecycleStatus","publicationStatus","locales","localizationStatus",
    "searchTextAr","searchTextEn","searchTextFr","inspirationBasis"
  ],
  "properties": {
    "id": {"type":"string","pattern":"^animated-story-[0-9]{3}$"},
    "slug": {"type":"string","minLength":3},
    "titleAr": {"type":"string","minLength":3},
    "titleEn": {"type":"string","minLength":3},
    "titleFr": {"type":"string","minLength":3},
    "ageGroup": {"enum":["5-7","8-10","11-13","14-16"]},
    "readingLevel": {"enum":["beginner","developing","intermediate","advanced"]},
    "readingLevelAr": {"type":"string","minLength":2},
    "readingLevelEn": {"type":"string","minLength":2},
    "readingLevelFr": {"type":"string","minLength":2},
    "category": {"enum":["kindness","honesty","courage","patience","curiosity","cooperation","responsibility","gratitude","nature","forgiveness"]},
    "categoryAr": {"type":"string","minLength":2},
    "categoryEn": {"type":"string","minLength":2},
    "categoryFr": {"type":"string","minLength":2},
    "secondaryTags": {"type":"array","minItems":1,"items":{"type":"string"}},
    "secondaryTagsAr": {"type":"array","minItems":1,"items":{"type":"string"}},
    "secondaryTagsEn": {"type":"array","minItems":1,"items":{"type":"string"}},
    "secondaryTagsFr": {"type":"array","minItems":1,"items":{"type":"string"}},
    "visualStyle": {"type":"string","minLength":3},
    "fictional": {"const":true},
    "historicalClaim": {"const":false},
    "synopsisAr": {"type":"string","minLength":20},
    "synopsisEn": {"type":"string","minLength":20},
    "synopsisFr": {"type":"string","minLength":20},
    "moralAr": {"type":"string","minLength":10},
    "moralEn": {"type":"string","minLength":10},
    "moralFr": {"type":"string","minLength":10},
    "locales": {"const":["ar","en","fr"]},
    "localizationStatus": {
      "type":"object","required":["ar","en","fr"],
      "properties":{"ar":{"const":"complete"},"en":{"const":"complete"},"fr":{"const":"complete"}}
    },
    "characters": {"type":"array","minItems":2,"items":{"$ref":"#/$defs/character"}},
    "storyAr": {"$ref":"#/$defs/storyBlocks"},
    "storyEn": {"$ref":"#/$defs/storyBlocks"},
    "storyFr": {"$ref":"#/$defs/storyBlocks"},
    "scenes": {"type":"array","minItems":10,"maxItems":10,"items":{"$ref":"#/$defs/scene"}},
    "cover": {"type":"object","required":["path","altAr","altEn","altFr","format"]},
    "estimatedReadingMinutes": {"type":"number","minimum":1},
    "estimatedAnimationMinutes": {"type":"number","minimum":1},
    "listenMode": {"enum":["native-audio","browser-tts"]},
    "watchMode": {"enum":["animated-storyboard","native-video"]},
    "capabilities": {"type":"object","required":["read","listen","watch"],"properties":{"read":{"type":"boolean"},"listen":{"type":"boolean"},"watch":{"type":"boolean"}}},
    "lifecycleStatus": {"enum":["DRAFT","SCRIPT_READY","ART_PENDING","ART_READY","AUDIO_PENDING","AUDIO_READY","ANIMATION_READY","REVISION","READY","PUBLISHED","FAILED"]},
    "publicationStatus": {"enum":["READY","PUBLISHED","FAILED","DRAFT"]},
    "searchTextAr": {"type":"string"},"searchTextEn": {"type":"string"},"searchTextFr": {"type":"string"},
    "inspirationBasis": {"type":"object"}
  },
  "$defs": {
    "storyBlocks": {"type":"array","minItems":10,"maxItems":10,"items":{"type":"object","required":["sceneNumber","text"],"properties":{"sceneNumber":{"type":"integer","minimum":1},"text":{"type":"string","minLength":40}}}},
    "character": {
      "type":"object",
      "required":["characterId","age","role","strengths","nameAr","nameEn","nameFr","personalityAr","personalityEn","personalityFr","weaknessAr","weaknessEn","weaknessFr","appearanceDescriptionAr","appearanceDescriptionEn","appearanceDescriptionFr","clothingDescriptionAr","clothingDescriptionEn","clothingDescriptionFr"],
      "properties":{"characterId":{"type":"string"},"age":{"type":"integer"},"role":{"type":"string"},"strengths":{"type":"array"}}
    },
    "scene": {
      "type":"object",
      "required":["sceneNumber","sceneTitle","sceneTitleEn","sceneTitleFr","settingAr","settingEn","settingFr","visualDescriptionAr","visualDescriptionEn","visualDescriptionFr","narration","narrationEn","narrationFr","dialogueAr","dialogueEn","dialogueFr","charactersPresent","emotionalToneAr","emotionalToneEn","emotionalToneFr","durationSeconds","animationInstructionsAr","animationInstructionsEn","animationInstructionsFr","illustrationPromptAr","illustrationPromptEn","illustrationPromptFr","illustration"],
      "properties":{"sceneNumber":{"type":"integer","minimum":1},"durationSeconds":{"type":"number","minimum":1},"illustration":{"type":"string"}}
    }
  }
}
