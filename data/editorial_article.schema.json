{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/prophet/editorial_article.schema.json",
  "title": "Genuine Source Editorial Article",
  "type": "object",
  "required": [
    "id", "title", "contentType", "sections", "publishedAt", "paragraphs", "sources",
    "sourceCoveragePercent", "aiOriginalSubstantiveContentPercent", "quotationVerification",
    "provenanceStatus", "unsupportedFactualParagraphs", "unverifiedQuotations", "duplicateCheck"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "slug": {"type": "string"},
    "language": {"type": "string"},
    "contentType": {
      "enum": [
        "SOURCE ARTICLE",
        "EXTRACTED BOOK MATERIAL",
        "TRANSCRIBED LECTURE",
        "TRANSLATED SOURCE",
        "EDITORIALLY COMPILED SOURCE ARTICLE"
      ]
    },
    "sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "publishedAt": {"type": "string", "format": "date-time"},
    "articleUrl": {"type": "string"},
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "sourceRefs", "substantive", "aiOriginal"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "substantive": {"type": "boolean"},
          "aiOriginal": {"const": false},
          "quotation": {"type": "boolean"},
          "quotationVerified": {"type": "boolean"},
          "editorialOperations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": {
          "ref": {"type": "string"},
          "title": {"type": "string"},
          "author": {"type": "string"},
          "edition": {"type": "string"},
          "volume": {"type": ["string", "integer"]},
          "pages": {"type": "string"},
          "chapter": {"type": "string"},
          "originalUrl": {"type": "string"},
          "resourceId": {"type": "string"},
          "ocrRef": {"type": "string"},
          "mediaTitle": {"type": "string"},
          "timestamps": {"type": "string"},
          "transcriptionRef": {"type": "string"},
          "translationSource": {"type": "string"},
          "verifiedAgainstOriginal": {"type": "boolean"}
        }
      }
    },
    "sourceCoveragePercent": {"const": 100},
    "aiOriginalSubstantiveContentPercent": {"const": 0},
    "quotationVerification": {"const": "PASS"},
    "provenanceStatus": {"const": "PASS"},
    "unsupportedFactualParagraphs": {"const": 0},
    "unverifiedQuotations": {"const": 0},
    "duplicateCheck": {"const": "PASS"}
  }
}
