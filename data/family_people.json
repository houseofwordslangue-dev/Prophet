    {"id":"al-zubayr-ibn-abd-al-muttalib","slug":"al-zubayr-ibn-abd-al-muttalib","name":{"ar":"الزبير بن عبد المطلب","en":"Al-Zubayr ibn Abd al-Muttalib","fr":"Al-Zubayr ibn Abd al-Muttalib"},"category":"family","relationship":"paternal-uncle","biography":{"ar":[],"en":[],"fr":[]},"sayings":{"ar":[],"en":[],"fr":[]},"sourcePassages":[{"language":"ar","relation":"biography-source","text":"ولد الزبير بن عبد المطلب: الطاهر؛ وحجل؛ وقرة؛ وعبد الله، وله صحبة قتل يوم أجنادين.","sources":[{"title":"جمهرة أنساب العرب","author":"ابن حزم الأندلسي","url":"https://ar.wikisource.org/wiki/جمهرة_أنساب_العرب/ولد_الزبير_بن_عبد_المطلب","verifiedAgainstOriginal":true}]}],"provenance":"verified-source-excerpt"},
    {"id":"abu-talib-ibn-abd-al-muttalib","slug":"abu-talib-ibn-abd-al-muttalib","name":{"ar":"أبو طالب بن عبد المطلب (عبد مناف)","en":"Abu Talib ibn Abd al-Muttalib (Abd Manaf)","fr":"Abu Talib ibn Abd al-Muttalib (Abd Manaf)"},"category":"family","relationship":"paternal-uncle","biography":{"ar":[],"en":[],"fr":[]},"sayings":{"ar":[],"en":[],"fr":[]},"sourcePassages":[{"language":"ar","relation":"biography-source","text":"وكان رسول الله ﷺ أحب خلق الله إليه طبعا، وكان يحنو عليه ويحسن إليه ويدافع عنه ويحامي.","sources":[{"title":"البداية والنهاية","author":"ابن كثير","url":"https://ar.wikisource.org/wiki/البداية_والنهاية/الجزء_الثالث/باب_الأمر_بابلاغ_الرسالة","verifiedAgainstOriginal":true}]}],"provenance":"verified-source-excerpt"},
    {"id":"hamza-ibn-abd-al-muttalib","slug":"hamza-ibn-abd-al-muttalib","name":{"ar":"حمزة بن عبد المطلب","en":"Hamza ibn Abd al-Muttalib","fr":"Hamza ibn Abd al-Muttalib"},"category":"companion","relationship":"paternal-uncle","biography":{"ar":[],"en":[],"fr":[]},"sayings":{"ar":[],"en":[],"fr":[]},"sourcePassages":[{"language":"ar","relation":"biography-source","text":"أسد الله أبو عمارة وأبو يعلى القرشي الهاشمي المكي ثم المدني البدري الشهيد عم رسول الله ﷺ وأخوه من الرضاعة.","sources":[{"title":"سير أعلام النبلاء","author":"الذهبي","url":"https://ar.wikisource.org/wiki/سير_أعلام_النبلاء/حمزة_بن_عبد_المطلب","verifiedAgainstOriginal":true}]}],"provenance":"verified-source-excerpt"},
    {"id":"al-abbas-ibn-abd-al-muttalib","slug":"al-abbas-ibn-abd-al-muttalib","name":{"ar":"العباس بن عبد المطلب","en":"Al-Abbas ibn Abd al-Muttalib","fr":"Al-Abbas ibn Abd al-Muttalib"},"category":"companion","relationship":"paternal-uncle","biography":{"ar":[],"en":[],"fr":[]},"sayings":{"ar":[],"en":[],"fr":[]},"sourcePassages":[{"language":"ar","relation":"biography-source","text":"القرشي الهاشمي أبو الفضل المكي عم رسول الله ﷺ، وكان أسن من رسول الله ﷺ بسنتين أو ثلاث.","sources":[{"title":"البداية والنهاية","author":"ابن كثير","url":"https://ar.wikisource.org/wiki/البداية_والنهاية_(ط._السعادة)/ثم_دخلت_سنه_ثنتين_وثلاثين/العباس_بن_عبد_المطلب","verifiedAgainstOriginal":true}]}],"provenance":"verified-source-excerpt"},
    {"id":"abu-lahab-ibn-abd-al-muttalib","slug":"abu-lahab-ibn-abd-al-muttalib","name":{"ar":"أبو لهب بن عبد المطلب (عبد العزى)","en":"Abu Lahab ibn Abd al-Muttalib (Abd al-Uzza)","fr":"Abu Lahab ibn Abd al-Muttalib (Abd al-Uzza)"},"category":"family","relationship":"paternal-uncle","biography":{"ar":[],"en":[],"fr":[]},"sayings":{"ar":[],"en":[],"fr":[]},"sourcePassages":[{"language":"ar","relation":"biography-source","text":"وكان من أشد الناس عليه عمه أبو لهب، واسمه عبد العزى بن عبد المطلب.","sources":[{"title":"البداية والنهاية","author":"ابن كثير","url":"https://ar.wikisource.org/wiki/البداية_والنهاية/الجزء_الثالث/باب_الأمر_بابلاغ_الرسالة","verifiedAgainstOriginal":true}]}],"provenance":"verified-source-excerpt"},
    {"id":"dirar-ibn-abd-al-muttalib","slug":"dirar-ibn-abd-al-muttalib","name":{"ar":"ضرار بن عبد المطلب","en":"Dirar ibn Abd al-Muttalib","fr":"Dirar ibn Abd al-Muttalib"},"category":"family","relationship":"paternal-uncle","biography":{"ar":[],"en":[],"fr":[]},"sayings":{"ar":[],"en":[],"fr":[]},"sourcePassages":[{"language":"ar","relation":"biography-source","text":"وأم العباس وضرار: نتيلة بنت جناب بن كليب بن مالك بن عمرو بن عامر بن النمر بن قاسط.","sources":[{"title":"جمهرة أنساب العرب","author":"ابن حزم الأندلسي","url":"https://www.masaha.org/book/view/1960/page/418","verifiedAgainstOriginal":true}]}],"provenance":"verified-source-excerpt"},
    {"id":"al-muqawwim-ibn-abd-al-muttalib","slug":"al-muqawwim-ibn-abd-al-muttalib","name":{"ar":"المقوّم بن عبد المطلب","en":"Al-Muqawwim ibn Abd al-Muttalib","fr":"Al-Muqawwim ibn Abd al-Muttalib"},"category":"family","relationship":"paternal-uncle","biography":{"ar":[],"en":[],"fr":[]},"sayings":{"ar":[],"en":[],"fr":[]},"sourcePassages":[{"language":"ar","relation":"biography-source","text":"ولد المقوم بن عبد المطلب: بكر؛ وعبد الله. فولد بكر بن المقوم: عبد الله ولا عقب للمقوم.","sources":[{"title":"جمهرة أنساب العرب","author":"ابن حزم الأندلسي","url":"https://ar.wikisource.org/wiki/جمهرة_أنساب_العرب/ولد_المقوم_بن_عبد_المطلب","verifiedAgainstOriginal":true}]}],"provenance":"verified-source-excerpt"},
    {"id":"hajl-al-mughira-ibn-abd-al-muttalib","slug":"hajl-al-mughira-ibn-abd-al-muttalib","name":{"ar":"حَجْل بن عبد المطلب (المغيرة)","en":"Hajl ibn Abd al-Muttalib (al-Mughira)","fr":"Hajl ibn Abd al-Muttalib (al-Mughira)"},"category":"family","relationship":"paternal-uncle","biography":{"ar":[],"en":[],"fr":[]},"sayings":{"ar":[],"en":[],"fr":[]},"sourcePassages":[{"language":"ar","relation":"biography-source","text":"وحجل واسمه المغيرة، والغيداق وهو كبير الجود، واسمه نوفل، ويقال إنه حجل.","sources":[{"title":"البداية والنهاية","author":"ابن كثير","url":"https://ar.wikisource.org/wiki/البداية_والنهاية_(ط._السعادة)/باب_ذكر_نسبه_الشريف_وطيب_أصله_المنيف","verifiedAgainstOriginal":true}]}],"provenance":"verified-source-excerpt"},
