SITE_DOMAIN=example.com
PM_HOST=0.0.0.0
PM_PORT=8080
PM_SECURE_COOKIE=1
PM_HSTS=1
PM_TRUST_PROXY=1
PM_SESSION_DAYS=14
PM_ADMIN_EMAIL=admin@example.com
PM_ADMIN_PASSWORD=CHANGE-THIS-TO-A-UNIQUE-PASSWORD-OF-AT-LEAST-14-CHARACTERS
PM_MFA_MASTER_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=
# Optional dedicated model for the source-grounded Ahbab Allah chatbot.
# If empty, functions/api/children-chat.js falls back to OPENAI_MODEL.
OPENAI_CHAT_MODEL=
OPENAI_REVIEW_MODEL=
PM_AI_GATEWAY_URL=
PM_AI_GATEWAY_KEY=

PM_DB_PATH=/app/data/site.db
PM_BACKUP_DIR=/app/backups
PM_AUTONOMOUS_CONTENT=1
PM_CONTENT_INTERVAL_SECONDS=900
PM_ADMIN_REVIEW_GRACE_SECONDS=300
PM_AUTO_IMPORT=1
PM_IMPORT_EVERY_CONTENT_CYCLE=1
PM_IMPORT_LIMIT=30
PM_AUTO_LOCALIZE=1

# Editorial articles: hard source-only gate.
# AI may edit language/formatting only; it may not author substantive article prose.
PM_EDITORIAL_SOURCE_ONLY=1
PM_EDITORIAL_AI_SUBSTANTIVE_GENERATION=0
PM_EDITORIAL_AI_LINGUISTIC_ONLY=1
PM_EDITORIAL_SOURCE_COVERAGE_REQUIRED=100
PM_EDITORIAL_UNSUPPORTED_PARAGRAPHS_ALLOWED=0
PM_EDITORIAL_UNVERIFIED_QUOTES_ALLOWED=0
PM_EDITORIAL_COVERAGE_WINDOW_HOURS=24
PM_EDITORIAL_CYCLE_HOURS=1
PM_EDITORIAL_DUPLICATE_THRESHOLD=0.88
PM_EDITORIAL_SOURCE_GAP_BLOCKS_PASS=1
PM_EDITORIAL_REPORT_EMAIL=houseofwords.langue@gmail.com

PM_HADITH_CORPUS_SYNC=1
PM_HADITH_REFRESH_DAYS=7
PM_HADITH_BOOKS=bukhari,muslim,abudawud,tirmidhi
PM_AUTO_HADITH_COMMENTARY=1
PM_HADITH_COMMENTARY_BATCH=50
PM_HADITH_COMMENTARY_INTERVAL_SECONDS=3600
PM_AUTO_SCHOLAR_SYNC=1
PM_SCHOLAR_SYNC_INTERVAL_SECONDS=86400
PM_SCHOLAR_WEB_PAGE_CAP=1000
PM_SCHOLAR_YT_MAX_PER_SOURCE=0
PM_AUTO_TAFSIR_SYNC=1
PM_TAFSIR_SYNC_INTERVAL_SECONDS=21600
PM_TAFSIR_AI_BATCH=100
PM_TAFSIR_AI_BATCH_FULL=6236
PM_AUTO_SEERAH_SYNC=1
PM_SEERAH_SYNC_INTERVAL_SECONDS=21600
PM_SEERAH_AI_BATCH=30
PM_AUTO_MEDIA_SYNC=1
PM_MEDIA_SYNC_INTERVAL_SECONDS=21600
PM_MEDIA_MAX_PER_SOURCE=0
PM_AUTO_HERITAGE_BOOTSTRAP=1
PM_HADITH_COMMENTARY_BATCH_FULL=500
PM_HADITH_COMMENTARY_FULL_MAX=0
